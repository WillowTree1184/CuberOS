SRC_DIR		?= $(CURDIR)/..

BUILDED_DIR_NAME ?= Builded

PUBLISH_OUTPUT_DIR	?= $(SRC_DIR)/Builded

SYSFS_DIR				?= $(PUBLISH_OUTPUT_DIR)/System
LAUNCHER_DIR			?= $(SRC_DIR)/Launcher
LAUNCHER_BUILDED_DIR	:= $(LAUNCHER_DIR)/$(BUILDED_DIR_NAME)
LAUNCHER_DIST_DIR		:= $(SYSFS_DIR)/Efi/Boot

REQUIRED_DIRS	:= $(PUBLISH_OUTPUT_DIR) $(SYSFS_DIR) $(LAUNCHER_DIST_DIR)

.PHONY: all
all: Launcher | $(REQUIRED_DIRS)

.PHONY: $(REQUIRED_DIRS)
$(REQUIRED_DIRS):
	@mkdir -p $@

Launcher: $(LAUNCHER_DIST_DIR)/BootX64.efi $(LAUNCHER_DIST_DIR)/BootX64.lib | $(LAUNCHER_DIST_DIR)

$(LAUNCHER_DIST_DIR)/%: $(LAUNCHER_BUILDED_DIR)/% | $(LAUNCHER_DIST_DIR)
	@cp "$<" "$@"